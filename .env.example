# ==============================================================================
# VRSOC — Environment Configuration Template
# ==============================================================================
# Copy this file to `.env.local` for local development.
# NEVER commit real credentials, production keys, or service role secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application & Client Configuration (Browser-Safe, NEXT_PUBLIC_ prefix)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="VRSOC — Cyber Defense Training"
NEXT_PUBLIC_APP_ENV=development

# ------------------------------------------------------------------------------
# 2. Supabase Client Configuration (Browser-Safe, NEXT_PUBLIC_ prefix)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.dummy_anon_key_for_local_development

# ------------------------------------------------------------------------------
# 3. Supabase Server Configuration (Server-Only, DO NOT expose to browser)
# ------------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=dummy_service_role_key_for_server_actions_only
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ------------------------------------------------------------------------------
# 4. Threat Intelligence Integrations (Server-Only)
# ------------------------------------------------------------------------------
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
SHODAN_API_KEY=
ALIENVAULT_OTX_API_KEY=

# ------------------------------------------------------------------------------
# 5. AI Security Assistant (Server-Only)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# ------------------------------------------------------------------------------
# 6. Notifications & Email (Server-Only)
# ------------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="VRSOC Alerts <alerts@vrsoc.app>"
SLACK_WEBHOOK_URL=
MS_TEAMS_WEBHOOK_URL=
